{
  "manifestVersion": 1,
  "id": "azure-devops-custom-input-info-parent-disabled-extension",
  "name": "Custom Input Infor Parent Extension",
  "publisher": "haiht-vmogroup",
  "version": "1.1.5",
  "description": "Custom Input Control Infor Parent for Azure DevOps Work Item Forms",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "categories": [
    "Azure Boards"
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "azure-devops-custom-input-info-parent-disabled-extension",
      "type": "ms.vss-work-web.work-item-form-control",
      "description": "Custom Input Infor Parent",
      "targets": [
        "ms.vss-work-web.work-item-form"
      ],
      "properties": {
        "name": "Custom Input Control Infor Parent",
        "uri": "dist/index.html",
        "inputs": [
          {
            "id": "Field",
            "name": "Field",
            "description": "Select a field for reading and saving value.",
            "type": "WorkItemField",
            "properties": {
              "workItemFieldTypes": [
                "String"
              ]
            },
            "validation": {
              "dataType": "String",
              "isRequired": true
            }
          }
        ]
      }
    }
  ]
}