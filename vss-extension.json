{
  "manifestVersion": 1,
  "id": "custom-input-extension-show-hide",
  "name": "Custom Input Extension With Show/Hide",
  "publisher": "haiht-vmogroup",
  "version": "1.2.4",
  "description": "Custom Input Control With Show/Hide for Azure DevOps Work Item Forms",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "categories": [
    "Azure Boards"
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "custom-input-extension-show-hide",
      "type": "ms.vss-work-web.work-item-form-control",
      "description": "Custom Input Field With Show/Hide",
      "targets": [
        "ms.vss-work-web.work-item-form"
      ],
      "properties": {
        "name": "Custom Input Control",
        "uri": "dist/index.html",
        "inputs": [
          {
            "id": "Label",
            "name": "Label",
            "type": "String",
            "properties": {
              "workItemFieldTypes": [
                "String"
              ]
            },
            "validation": {
              "dataType": "String",
              "isRequired": true
            }
          },
          {
            "id": "Field",
            "name": "Field",
            "description": "Select a field for reading and saving value.",
            "type": "WorkItemField",
            "properties": {
              "workItemFieldTypes": [
                "String"
              ]
            },
            "validation": {
              "dataType": "String",
              "isRequired": true
            }
          },
          {
            "id": "IsDisabled",
            "name": "IsDisabled",
            "description": "Disable the input field.",
            "type": "boolean",
            "validation": {
              "isRequired": false
            }
          }
        ]
      }
    }
  ]
}